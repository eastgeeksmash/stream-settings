{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stream Settings",
  "version": "0.1.5",
  "identifier": "com.eastgeeksmash.stream-settings",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stream Settings",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "EastGeekSMash",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh",
        "startMenuFolder": "EastGeekSMash"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxN0Y3RjgwMEUxMjRCM0YKUldRL1N4SU9nSDkvMFgzRVY3bmtuMERVMSt5Szh4dGZ6bGtwZmlCWnFSQXo1YjRnRWZ6OTMzMm4K",
      "endpoints": [
        "https://github.com/eastgeeksmash/stream-settings/releases/latest/download/latest.json"
      ]
    }
  }
}
